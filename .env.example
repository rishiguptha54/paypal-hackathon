# Copy to .env (git-ignored). Never commit real values.
# Secrets and credentials are <REPLACE_ME>; the app refuses to boot until they are set.
# Non-secret settings carry their safe defaults.

NODE_ENV=development
PORT=3000

# Hosted Postgres (TLS is verified for any non-localhost host)
DATABASE_URL=<REPLACE_ME>
# >= 32 random characters; signs the il_sid cookie (e.g. `openssl rand -base64 48`)
SESSION_SECRET=<REPLACE_ME>

# PayPal Sandbox only: boot fails for any other value
PAYPAL_CLIENT_ID=<REPLACE_ME>
PAYPAL_CLIENT_SECRET=<REPLACE_ME>
PAYPAL_ENV=sandbox
# Optional. Empty = launch the pinned @paypal/mcp from node_modules over stdio.
# The child only receives a short-lived sandbox access token, never the client secret.
PAYPAL_MCP_COMMAND=
# Stage 7+ (webhooks, P2)
PAYPAL_WEBHOOK_ID=<REPLACE_ME>

# Gemini structured-output intent parser; use rule for offline development (no key needed).
AI_PROVIDER=rule
AI_API_KEY=<REPLACE_ME>
AI_MODEL=gemini-3.8-flash

# Stage 2 product catalog (fixture = offline catalog, no key needed)
PRODUCT_SOURCE=fixture
CHANNEL3_API_KEY=<REPLACE_ME>

APPROVAL_TTL_SECONDS=900
POLICY_VERSION=v1

# Browser-exposed AG Studio license, not a server credential. Check trial/license scope.
# Build-time only; never commit a real key or put API secrets in this variable.
VITE_AG_STUDIO_KEY=<REPLACE_ME>
STUDIO_AGENT_ENABLED=false
DEMO_CONTROLS_ENABLED=false
